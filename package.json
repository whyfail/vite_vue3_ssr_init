{
  "name": "{{ name }}",
  "version": "1.0.0",
  "private": true,
  "description": "{{ description }}",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "start": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "api:generate": "nuxt prepare && orval",
    "test": "nuxt prepare && vitest run",
    "test:coverage": "nuxt prepare && vitest run --coverage",
    "test:junit": "nuxt prepare && vitest run --reporter=junit --outputFile=test-results/vitest-junit.xml",
    "test:watch": "nuxt prepare && vitest",
    "test:ui": "nuxt prepare && vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:component-coverage": "node scripts/check-component-tests.js",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint . --vue-plugin --import-plugin --deny-warnings && eslint .",
    "lint:fix": "oxlint . --vue-plugin --import-plugin --fix && eslint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.64.0",
    "@pinia/nuxt": "^1.0.3",
    "@tanstack/vue-table": "^9.3.1",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "h3": "^1.15.11",
    "nuxt": "^4.6.3",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.44",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "code-inspector-plugin": "^2.0.9",
    "eslint": "^10.13.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "msw": "^3.0.3",
    "orval": "^8.45.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "sass": "^1.107.0",
    "shadcn-vue": "^2.9.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": "oxlint --vue-plugin --import-plugin --fix --no-error-on-unmatched-pattern",
    "*.vue": "eslint --fix --no-warn-ignored",
    "*.{js,jsx,ts,tsx,vue,json,jsonc,css,scss,html,md,yml,yaml}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
