{
  "name": "{{ name }}",
  "version": "1.0.0",
  "private": true,
  "description": "{{ description }}",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "start": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "test": "nuxt prepare && vitest run",
    "test:coverage": "nuxt prepare && vitest run --coverage",
    "test:junit": "nuxt prepare && vitest run --reporter=junit --outputFile=test-results/vitest-junit.xml",
    "test:watch": "nuxt prepare && vitest",
    "test:ui": "nuxt prepare && vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:component-coverage": "node scripts/check-component-tests.js",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint . --vue-plugin --import-plugin --deny-warnings && eslint .",
    "lint:fix": "oxlint . --vue-plugin --import-plugin --fix && eslint . --fix",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@heroicons/vue": "^2.2.0",
    "@lucide/vue": "^1.46.0",
    "@pinia/nuxt": "^1.0.2",
    "@tanstack/vue-table": "^9.2.4",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.42",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@testing-library/vue": "^8.1.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.5",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "code-inspector-plugin": "^2.0.9",
    "eslint": "^10.10.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "sass": "^1.104.1",
    "shadcn-vue": "^2.8.2",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": "oxlint --vue-plugin --import-plugin --fix --no-error-on-unmatched-pattern",
    "*.vue": "eslint --fix --no-warn-ignored",
    "*.{js,jsx,ts,tsx,vue,json,jsonc,css,scss,html,md,yml,yaml}": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
