NUXT_PUBLIC_APP_NAME=Vue SSR Template
NUXT_PUBLIC_API_BASE_URL=/api
NUXT_API_BASE_URL=
# 服务端私有的后端地址，禁止暴露到浏览器
NUXT_BACKEND_API_BASE_URL=http://localhost:8080/api/v1
# 会话 Mock 开关：显式设为 true 才启用（无后端本地开发/模板 E2E），生产保持 false
NUXT_ENABLE_AUTH_MOCK=false
NUXT_ENABLE_CODE_INSPECTOR=true
NUXT_ENABLE_CODE_INSPECTOR_ACTION=open
